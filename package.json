{
  "name": "helpmedecide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.app.json --noEmit && node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/generate-brief-types.mjs --check && node scripts/generate-research-types.mjs --check && node scripts/generate-exploration-types.mjs --check && tsx scripts/run-tests.mjs && node scripts/build-output.test.mjs && npm run test:a2ui",
    "test:a2ui": "node scripts/run-a2ui-test.mjs",
    "test:watch": "tsx scripts/run-tests.mjs",
    "contracts:generate": "node scripts/generate-brief-types.mjs && node scripts/generate-research-types.mjs && node scripts/generate-exploration-types.mjs"
  },
  "dependencies": {
    "@a2ui/react": "0.14.0",
    "@a2ui/web_core": "0.14.0",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
